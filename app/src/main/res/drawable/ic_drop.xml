<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Outer glow for top arrow -->
    <path
        android:fillColor="#44B026FF"
        android:pathData="M6,3 L12,9 L18,3 Z"/>

    <!-- Main top arrow with gradient -->
    <path android:pathData="M7,4 L12,8 L17,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="7"
                android:startY="4"
                android:endX="17"
                android:endY="8"
                android:startColor="#FF006E"
                android:centerColor="#CC0055"
                android:endColor="#99003F"/>
        </aapt:attr>
    </path>

    <!-- Highlight for top arrow -->
    <path
        android:fillColor="#AAFFFFFF"
        android:pathData="M11,4.5 L12,5.5 L13,4.5 Z"/>

    <!-- Outer glow for bottom arrow -->
    <path
        android:fillColor="#4400D9FF"
        android:pathData="M6,9 L12,15 L18,9 Z"/>

    <!-- Main bottom arrow with gradient -->
    <path android:pathData="M7,10 L12,14 L17,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="7"
                android:startY="10"
                android:endX="17"
                android:endY="14"
                android:startColor="#00E5FF"
                android:centerColor="#00B8D4"
                android:endColor="#0091B8"/>
        </aapt:attr>
    </path>

    <!-- Highlight for bottom arrow -->
    <path
        android:fillColor="#AAFFFFFF"
        android:pathData="M11,10.5 L12,11.5 L13,10.5 Z"/>

    <!-- Additional motion lines for speed effect -->
    <path
        android:strokeColor="#66FF006E"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M9,16 L12,19 L15,16"/>
    <path
        android:strokeColor="#4400D9FF"
        android:strokeWidth="1.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M10,20 L12,22 L14,20"/>

    <!-- Neon borders -->
    <path
        android:strokeColor="#FF88AA"
        android:strokeWidth="1.2"
        android:fillColor="@android:color/transparent"
        android:pathData="M7,4 L12,8 L17,4 Z"/>
    <path
        android:strokeColor="#00FFFF"
        android:strokeWidth="1.2"
        android:fillColor="@android:color/transparent"
        android:pathData="M7,10 L12,14 L17,10 Z"/>
</vector>
