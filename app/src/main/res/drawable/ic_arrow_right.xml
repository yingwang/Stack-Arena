<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Outer glow layers for depth -->
    <path
        android:fillColor="#3300D9FF"
        android:pathData="M7,5 L19,12 L7,19 Z"/>
    <path
        android:fillColor="#5500D9FF"
        android:pathData="M8,6 L18,12 L8,18 Z"/>

    <!-- Main thick arrow body with gradient -->
    <path android:pathData="M9,7 L17,12 L9,17 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="9"
                android:startY="7"
                android:endX="17"
                android:endY="17"
                android:startColor="#00E5FF"
                android:centerColor="#00B8D4"
                android:endColor="#0091B8"/>
        </aapt:attr>
    </path>

    <!-- Bright highlight for 3D effect -->
    <path
        android:fillColor="#CCFFFFFF"
        android:pathData="M10,9 L14,12 L10,15 L10,9 Z"/>

    <!-- Additional inner glow -->
    <path
        android:fillColor="#4400FFFF"
        android:pathData="M11,10 L14.5,12 L11,14 Z"/>

    <!-- Thick neon border with strong glow -->
    <path
        android:strokeColor="#00FFFF"
        android:strokeWidth="2.5"
        android:fillColor="@android:color/transparent"
        android:pathData="M9,7 L17,12 L9,17 Z"/>
</vector>
