<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#5500D9FF"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <!-- Main button -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#1A1F3A"
                        android:endColor="#2A2F4A"
                        android:type="linear"/>
                    <corners android:radius="14dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="#00B4D8"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <!-- Outer glow -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#8800D9FF"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <!-- Main button -->
            <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#2A2F4A"
                        android:endColor="#1A1F3A"
                        android:type="linear"/>
                    <corners android:radius="14dp"/>
                    <stroke
                        android:width="2dp"
                        android:color="#00D9FF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
