<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme with neon cyberpunk design -->
    <style name="Theme.StackArena" parent="Theme.AppCompat.NoActionBar">
        <!-- Primary brand color - Neon Cyan -->
        <item name="colorPrimary">@color/neon_blue</item>
        <item name="colorPrimaryDark">@color/dark_bg_primary</item>
        <item name="colorAccent">@color/neon_cyan</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/dark_bg_primary</item>
        <item name="android:colorBackground">@color/dark_bg_primary</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/dark_bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/dark_bg_primary</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/neon_cyan</item>
        <item name="android:textColorSecondary">@color/neon_purple</item>
    </style>
</resources>
